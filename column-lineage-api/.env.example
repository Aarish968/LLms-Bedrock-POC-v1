# Database Configuration
DATABASE_URL=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=

# AWS CodeCommit Configuration
AWS_CODECOMMIT_USERNAME=your_codecommit_username
AWS_CODECOMMIT_PASSWORD=your_codecommit_password
AWS_CODECOMMIT_REGION=us-east-1

# Default Repository Configuration
DEFAULT_FRONTEND_REPO=guided-workflow
DEFAULT_BACKEND_REPO=guided-workflow-backend

# API Configuration
PROJECT_NAME=Column Lineage API
VERSION=0.1.0
API_V1_PREFIX=/api/v1
RUN_ENV=dev
DEBUG=false

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# Auto-save Configuration
AUTO_SAVE_RESULTS=true
AUTO_SAVE_TO_DATABASE=true
RESULTS_DIRECTORY=analysis_results

# Base View Configuration
BASE_VIEW_TABLE=PUBLIC.BASE_VIEW
BASE_VIEW_SAFETY_LIMIT=10000
VIEWS_SAFETY_LIMIT=1000

# Database Bulk Insert Configuration
BULK_INSERT_BATCH_SIZE=100

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json